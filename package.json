{
  "name": "overround-lab",
  "version": "1.0.0",
  "private": true,
  "description": "Overround Lab: a classroom sports-forecasting and market-analysis studio (simulation points only).",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run build && node --disable-warning=ExperimentalWarning build/server.mjs",
    "serve": "node --disable-warning=ExperimentalWarning build/server.mjs",
    "build": "vite build && node scripts/build-server.mjs",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@fastify/static": "8.3.0",
    "fast-xml-parser": "5.11.2",
    "fastify": "5.12.5",
    "ipaddr.js": "2.2.0",
    "luxon": "3.7.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@playwright/test": "1.56.1",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.1.4",
    "esbuild": "0.25.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  }
}
