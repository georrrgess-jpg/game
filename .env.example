# Overround Lab configuration. Copy to `.env` (same folder as package.json) and fill in what you need.
# Everything is optional: with no keys at all, the fictional demo, Classroom Lab, Model Report and
# calculators work offline, and the keyless providers (MLB Stats API, Open-Meteo, RSS) can be enabled
# in Settings. Never commit your real .env file. Keys stay on the server and are never sent to the browser.

# --- Server ---
# Listen address. Keep 127.0.0.1 (this computer only) unless you deliberately want network access.
HOST=127.0.0.1
PORT=5180
# Exposing the app to your network requires both of these:
# ALLOW_REMOTE=1
# INSTRUCTOR_PIN=choose-a-pin

# Protects Settings and instructor controls (demo clock, hide results, new session). Recommended in a classroom.
INSTRUCTOR_PIN=

# Where the SQLite database is stored (default: ./data).
# OVERROUND_DATA_DIR=./data

# --- Market quotes: The Odds API (https://the-odds-api.com/liveapi/guides/v4/) ---
# Free starter tier available; usage is metered in credits. Set daily caps in Settings before enabling.
ODDS_API_KEY=

# --- Optional AI explanations (Anthropic API) ---
# Off by default. Only used when a person clicks "AI summary" and it is enabled in Settings.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Optional extra news feeds (comma-separated https RSS/Atom URLs, treated as "media" tier) ---
# NEWS_FEEDS=https://example.com/feed.xml
